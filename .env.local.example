# Zoho CRM — booking form submissions are created as Leads here.
#
# 1. Create a "Server-based Application" client at:
#    https://api-console.zoho.in/  (use the console matching your Zoho
#    data center — .in, .com, .eu, .com.au, .jp — this project defaults
#    to the India (.in) data center)
# 2. Generate a Grant Token with scope: ZohoCRM.modules.leads.CREATE
# 3. Exchange the grant token for a refresh token (one-time, via curl or
#    Postman) — see https://www.zoho.com/crm/developer/docs/api/v2/oauth-overview.html
# 4. Fill in the values below.
ZOHO_CLIENT_ID=your-client-id
ZOHO_CLIENT_SECRET=your-client-secret
ZOHO_REFRESH_TOKEN=your-refresh-token

# Only change these if your Zoho account is on a different data center
# than India (.in). Match whichever domain you used in the API console.
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in

# Optional: Zoho does NOT apply assignment rules automatically to leads
# created via the API — the rule's ID must be passed explicitly. Find it
# by opening Setup > Automation > Assignment Rules > (your rule) and
# copying the numeric ID from the browser URL.
ZOHO_ASSIGNMENT_RULE_ID=

# Optional: comma-separated list of webhook URLs. Each verified booking
# submission is POSTed as JSON to every URL listed here — point this at
# a Pabbly Connect webhook trigger, a Google Apps Script Web App URL (to
# append rows to a Sheet), Zapier, Make.com, n8n, or any other endpoint
# that accepts POST JSON. Add/remove platforms by editing this list, no
# code changes needed.
#
# Payload shape:
# { "name", "phone", "countryCode", "age", "painArea", "branch", "submittedAt", "source" }
BOOKING_WEBHOOK_URLS=

# Optional: enables an INBOUND integration endpoint at
# POST /api/webhook/booking, so another system (a partner CRM, a
# separate intake form, an automation platform) can push a lead into
# this app the same way our own booking form does — creates the Zoho
# lead and fans out to BOOKING_WEBHOOK_URLS above.
#
# Set this to a long random secret and give it only to whoever you want
# calling this endpoint — they must send it as the `X-Webhook-Secret`
# header on every request. Leave unset to keep the endpoint disabled;
# it refuses all requests (503) when this isn't configured, so it can
# never accidentally be left open.
#
# Required JSON body: { "name", "countryCode", "phone", "age", "pain", "branch" }
INBOUND_WEBHOOK_SECRET=
